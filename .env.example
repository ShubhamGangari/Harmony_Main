# Deployment Domain Configuration (Required for Staging/Production SEO & Sitemaps)
# Note: "https://harmonyofcells.com" is pending client DNS & SSL confirmation.
# For staging: NEXT_PUBLIC_SITE_URL="https://staging.yourdomain.com"
NEXT_PUBLIC_SITE_URL="https://harmonyofcells.com"

# Commerce Mode Gate ("inquiry" | "cart")
# Default: "inquiry" (WhatsApp & inquiry-first ordering until logistics/inventory is verified)
NEXT_PUBLIC_COMMERCE_MODE="inquiry"

# Server-only Web3Forms credentials. Do not use a NEXT_PUBLIC_ prefix.
WEB3FORMS_ACCESS_KEY=
NOTIFICATION_EMAIL=darkyfactbusiness@gmail.com

# Razorpay API Credentials
